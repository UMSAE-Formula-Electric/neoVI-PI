# Ignore log files and testing directories
/logs*
/testing*
__pycache__
# *.json
# ...but GSD planning config must be tracked
!.planning/**/*.json
# Ignore virtual environment directories
venv/
env/
# Ignore compiled Python files
*.pyc
# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/
# Ignore data files
*.csv
# ...but planning report artifacts (e.g. the D-16 compression-gate report) must be tracked
!.planning/**/*.csv
*.xlsx
*.h5
*.hdf5
*.pkl
*.zip
*.tar.gz
# Ignore Node.js modules
node_modules/
# Ignore IDE specific files
.vscode/