{
    "configurations": [
        {
            "name": "Python Debugger: Car-side logger (synthetic source)",
            "type": "debugpy",
            "request": "launch",
            "module": "telemetry.logger.cli",
            "args": ["--source", "synthetic", "--duration-s", "5"],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        }
    ]
}